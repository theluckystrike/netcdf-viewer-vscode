{
  "name": "hdf5-netcdf-explorer",
  "displayName": "NetCDF Viewer & HDF5 Viewer (NC Viewer, H5 Viewer)",
  "description": "NetCDF viewer and HDF5 viewer for .nc, .h5 and .hdf5 files. Browse groups and CF metadata, page through values, plot maps with coastlines, play through time, click a point for its time series and save plots as PNG. Offline, no Python.",
  "version": "0.6.1",
  "publisher": "zovo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0B2A3C",
    "theme": "dark"
  },
  "homepage": "https://github.com/theluckystrike/netcdf-viewer-vscode#readme",
  "bugs": {
    "url": "https://github.com/theluckystrike/netcdf-viewer-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/netcdf-viewer-vscode"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "nc viewer",
    "netcdf viewer",
    "hdf5 viewer",
    "h5 viewer",
    "hdf viewer",
    "netcdf",
    "hdf5",
    "h5",
    "nc",
    "netcdf4",
    "hdf",
    "cdf",
    "scientific data",
    "xarray",
    "h5py",
    "matlab",
    "climate",
    "weather",
    "earth science",
    "cf conventions",
    "ncdump",
    "cdf5",
    "heatmap",
    "colormap",
    "time series",
    "plot",
    "coastlines",
    "data science",
    "map",
    "offline"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "hdf5NetcdfExplorer.viewer",
        "displayName": "HDF5 NetCDF Explorer",
        "selector": [
          {
            "filenamePattern": "*.h5"
          },
          {
            "filenamePattern": "*.hdf5"
          },
          {
            "filenamePattern": "*.he5"
          },
          {
            "filenamePattern": "*.hdf"
          },
          {
            "filenamePattern": "*.nc"
          },
          {
            "filenamePattern": "*.nc4"
          },
          {
            "filenamePattern": "*.netcdf"
          },
          {
            "filenamePattern": "*.cdf"
          },
          {
            "filenamePattern": "*.nxs"
          },
          {
            "filenamePattern": "*.h5ad"
          },
          {
            "filenamePattern": "*.jld2"
          },
          {
            "filenamePattern": "*.loom"
          },
          {
            "filenamePattern": "*.h5mu"
          },
          {
            "filenamePattern": "*.hf5"
          },
          {
            "filenamePattern": "*.h5oina"
          },
          {
            "filenamePattern": "*.h5ebsd"
          },
          {
            "filenamePattern": "*.edaxh5"
          },
          {
            "filenamePattern": "*.oh5"
          },
          {
            "filenamePattern": "*.dream3d"
          },
          {
            "filenamePattern": "*.geoh5"
          },
          {
            "filenamePattern": "*.nde"
          },
          {
            "filenamePattern": "*.cxi"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "hdf5NetcdfExplorer.anyFile",
        "displayName": "HDF5 NetCDF Explorer (any file)",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "hdf5NetcdfExplorer.openWith",
        "title": "Open in HDF5 NetCDF Explorer",
        "category": "HDF5 NetCDF"
      },
      {
        "command": "hdf5NetcdfExplorer.openWalkthrough",
        "title": "Get Started",
        "category": "HDF5 NetCDF"
      },
      {
        "command": "hdf5NetcdfExplorer.supportDeveloper",
        "title": "Support the developer",
        "category": "HDF5 NetCDF"
      },
      {
        "command": "hdf5NetcdfExplorer.moreViewers",
        "title": "More free viewers",
        "category": "HDF5 NetCDF"
      },
      {
        "command": "hdf5NetcdfExplorer.compareFiles",
        "title": "Compare Two NetCDF or HDF5 Files",
        "category": "NetCDF Viewer Pro"
      },
      {
        "command": "hdf5NetcdfExplorer.exportSubset",
        "title": "Export Subset of a Variable (NetCDF or CSV)...",
        "category": "NetCDF Viewer Pro"
      },
      {
        "command": "hdf5NetcdfExplorer.getPro",
        "title": "Get Zovo Pro (USD 19 once, all 22 Zovo extensions)",
        "category": "Zovo Pro"
      },
      {
        "command": "hdf5NetcdfExplorer.unlockWithSponsors",
        "title": "I already paid: unlock with GitHub Sponsors",
        "category": "Zovo Pro"
      },
      {
        "command": "hdf5NetcdfExplorer.payWithPayPal",
        "title": "Pay for Zovo Pro with PayPal (USD 19, team of 5 USD 59)",
        "category": "Zovo Pro"
      },
      {
        "command": "hdf5NetcdfExplorer.enterLicenseKey",
        "title": "Enter Zovo Pro license key",
        "category": "Zovo Pro"
      },
      {
        "command": "hdf5NetcdfExplorer.removeLicense",
        "title": "Remove Zovo Pro from this editor",
        "category": "Zovo Pro"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "hdf5NetcdfExplorer.openWith",
          "when": "resourceExtname =~ /^\\.(h5|hdf5|he5|hdf|nc|nc4|netcdf|cdf|nxs|h5ad|mat|jld2|loom|h5mu|hf5|h5oina|h5ebsd|edaxh5|oh5|dream3d|geoh5|nde|cxi)$/i",
          "group": "navigation@20"
        },
        {
          "command": "hdf5NetcdfExplorer.compareFiles",
          "when": "listMultiSelection && !explorerResourceIsFolder && resourceExtname =~ /^\\.(nc|nc4|netcdf|cdf|h5|hdf5|he5|hdf|nxs|h5ad|mat|jld2|loom)$/i && (config.hdf5NetcdfExplorer.showProFeatures || hdf5NetcdfExplorer.proLicensed)",
          "group": "3_compare@90"
        },
        {
          "command": "hdf5NetcdfExplorer.exportSubset",
          "when": "!listMultiSelection && !explorerResourceIsFolder && resourceExtname =~ /^\\.(nc|nc4|netcdf|cdf|h5|hdf5|he5|hdf|nxs|h5ad|mat|jld2|loom)$/i && (config.hdf5NetcdfExplorer.showProFeatures || hdf5NetcdfExplorer.proLicensed)",
          "group": "navigation@91"
        }
      ],
      "commandPalette": [
        {
          "command": "hdf5NetcdfExplorer.compareFiles",
          "when": "config.hdf5NetcdfExplorer.showProFeatures || hdf5NetcdfExplorer.proLicensed"
        },
        {
          "command": "hdf5NetcdfExplorer.exportSubset",
          "when": "config.hdf5NetcdfExplorer.showProFeatures || hdf5NetcdfExplorer.proLicensed"
        },
        {
          "command": "hdf5NetcdfExplorer.getPro",
          "when": "config.hdf5NetcdfExplorer.showProFeatures || hdf5NetcdfExplorer.proLicensed"
        },
        {
          "command": "hdf5NetcdfExplorer.unlockWithSponsors",
          "when": "config.hdf5NetcdfExplorer.showProFeatures || hdf5NetcdfExplorer.proLicensed"
        },
        {
          "command": "hdf5NetcdfExplorer.payWithPayPal",
          "when": "config.hdf5NetcdfExplorer.showProFeatures || hdf5NetcdfExplorer.proLicensed"
        },
        {
          "command": "hdf5NetcdfExplorer.enterLicenseKey",
          "when": "config.hdf5NetcdfExplorer.showProFeatures || hdf5NetcdfExplorer.proLicensed"
        },
        {
          "command": "hdf5NetcdfExplorer.removeLicense",
          "when": "hdf5NetcdfExplorer.proLicensed"
        }
      ]
    },
    "configuration": {
      "title": "HDF5 NetCDF Explorer",
      "properties": {
        "hdf5NetcdfExplorer.maxReadValues": {
          "type": "number",
          "default": 1000000,
          "minimum": 10000,
          "description": "Largest number of values one read may return. A table page or a plot that needs more is refused with a message. Plots of big arrays are sampled to stay under 512 x 512."
        },
        "hdf5NetcdfExplorer.maxFileSizeMB": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Refuse to open files larger than this many MB. 0 means no limit, because files are read by slice and never loaded whole."
        },
        "hdf5NetcdfExplorer.readTimeoutSeconds": {
          "type": "number",
          "default": 20,
          "minimum": 2,
          "description": "Stop a read that takes longer than this. The reader restarts and VS Code stays responsive."
        },
        "hdf5NetcdfExplorer.colormap": {
          "type": "string",
          "default": "viridis",
          "enum": [
            "viridis",
            "cividis",
            "magma",
            "inferno",
            "plasma",
            "turbo",
            "gray",
            "coolwarm"
          ],
          "enumDescriptions": [
            "Perceptually uniform, purple to yellow (default)",
            "Uniform and readable with colour vision deficiency",
            "Black to light yellow through purple",
            "Black to light yellow through red",
            "Blue to yellow through magenta",
            "Rainbow-like, high contrast",
            "Black to white",
            "Diverging: blue for low, white in the middle, red for high (RdBu reversed)"
          ],
          "description": "Colour map for heatmaps when a file is opened. You can change it in the plot, and the viewer remembers your choice for each file."
        },
        "hdf5NetcdfExplorer.askForRating": {
          "type": "boolean",
          "default": true,
          "description": "Ask for a rating after 2 files opened without an error in 2 sessions at least 4 hours apart. \"Rate it\" opens the Marketplace review page in VS Code and the Open VSX one in Cursor, Windsurf and VSCodium. \"Later\" asks one more time after 7 days, \"No thanks\" never asks again. It never asks after an error or more than 2 times. Nothing is sent anywhere."
        },
        "hdf5NetcdfExplorer.showSupportLinks": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Sponsor and More free viewers links at the bottom of the viewer. The change shows in files you open next. Nothing is sent anywhere."
        },
        "hdf5NetcdfExplorer.showProFeatures": {
          "type": "boolean",
          "default": true,
          "description": "Show the Zovo Pro tools (the Compare with... and Export subset... buttons with their PRO badge, and the Pro commands). Turn it off to see only the free viewer. A Zovo Pro license always shows them."
        },
        "hdf5NetcdfExplorer.compareTolerance": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Compare two files (Zovo Pro): values that differ by this much or less count as equal, like nccmp -T. 0 means exact."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "hdf5NetcdfExplorer.start",
        "title": "Get started with HDF5 NetCDF Explorer",
        "description": "Open a .nc or .h5 file, pick a variable, and look at its values and plots.",
        "steps": [
          {
            "id": "open",
            "title": "Open an HDF5 or NetCDF file",
            "description": "Click a .nc, .nc4, .h5 or .hdf5 file in the Explorer. It opens in the viewer, not as binary text.\n[Open a file](command:hdf5NetcdfExplorer.openWith)",
            "media": {
              "markdown": "walkthrough/open.md"
            },
            "completionEvents": [
              "onCommand:hdf5NetcdfExplorer.openWith"
            ]
          },
          {
            "id": "browse",
            "title": "Pick a variable",
            "description": "The tree on the left shows groups, variables and coordinates. Click one to see its type, shape, chunks, compression, units and attributes.",
            "media": {
              "image": "images/screenshot.png",
              "altText": "A NetCDF temperature field drawn as a heatmap with its metadata above it."
            }
          },
          {
            "id": "slice",
            "title": "Slice, page and plot",
            "description": "Choose the row and column dimensions, move the sliders for the other ones, and switch between Table and Plot. Copy the same slice as xarray or h5py code.\n[Open settings](command:workbench.action.openSettings?%5B%22hdf5NetcdfExplorer%22%5D)",
            "media": {
              "markdown": "walkthrough/slice.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.openSettings"
            ]
          },
          {
            "id": "zovo-related",
            "title": "Files that often come with HDF5 and NetCDF files",
            "description": "If your project also has pickle files or tensor files, these free Zovo extensions open them. A link opens the extension page, and you choose there whether to install it.\n[Pickle Viewer](command:extension.open?%5B%22zovo.zovo-pickle-viewer%22%5D)\n[Tensor Viewer](command:extension.open?%5B%22zovo.tensor-viewer%22%5D)",
            "media": {
              "markdown": "walkthrough/related.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.js --production",
    "test": "node --test test/*.test.mjs",
    "samples": "python3 scripts/make-samples.py",
    "package": "node scripts/build.js --production && npx -y @vscode/vsce package --no-dependencies -o dist/"
  },
  "dependencies": {
    "h5wasm": "^0.10.3",
    "h5wasm-plugins": "^0.3.0",
    "netcdfjs": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/theluckystrike/sponsorships?tier_id=679878"
  }
}
